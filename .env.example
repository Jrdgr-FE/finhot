# FinHot 的配置。复制成 .env 再改（或者运行 node scripts/init-env.ts，它会生成 .env 并填好随机密钥）。
# 前端只拿到网站地址；所有密钥只在后端。不要把 .env 提交到 Git。

# ===== 必填 =====

# 网站对外的地址：生成的链接、RSS、分享图、MCP 都用它。本机试用就用下面这个。
SITE_URL=http://localhost:3000

# 管理员密码（至少 12 位），登录 /admin 用。
ADMIN_PASSWORD=

# 会话签名和图片代理签名的密钥，各填一串随机字符（可以用 openssl rand -hex 32 生成）。
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# 用 Docker 时数据库的密码（数据库不对外开放端口，也请用随机字符）。
POSTGRES_PASSWORD=

# 模型：任何 OpenAI 兼容接口都可以，所有步骤默认都用它。下面是 DeepSeek 的写法。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 服务商特有的请求参数（JSON），比如关掉思考模式：
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# 其他服务商的例子：
#   千问      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   智谱      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash
# 模型能看图就打开（精选内容的标题摘要会参考首图）：
# LLM_VISION=true
# 服务不支持 JSON 模式（response_format）时关掉：
# LLM_JSON_MODE=false

# ===== 选填：让事件归组更准 =====

# 向量召回：任何 OpenAI 兼容的 /embeddings 接口。不填也能跑，只是归组少一路线索。
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# 或者只填阿里云百炼的 key，就用 text-embedding-v4：
# DASHSCOPE_API_KEY=

# ===== 选填：每一步单独换模型 =====
# 默认每一步都用上面的 LLM_*。想让某一步用别家，填预设名（需要对应的 key）：
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL  MONITOR_MODEL
# 预设名与需要的 key：
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# 一种分工的例子（供参考）：
#   PREFILTER_MODEL=qwen3.7-flash  SCORE_MODEL=glm-5.3-flash-selection  UNDERSTAND_MODEL=glm-5.3-flash
#   SUMMARIZE_MODEL=deepseek-flash  STRUCTURE_MODEL=qwen3.8-flash  GROUP_MODEL=deepseek-flash
#   GROUP_REVIEW_MODEL=mimo-v2.6-flash  DIGEST_MODEL=deepseek-flash  REPORT_MODEL=deepseek-flash

# ===== 选填：付费的采集服务（按请求计费，有预算熔断，在后台“设置”里调） =====
# X（推特）账号：SocialData（Codex 重置监控也靠它读 X，不填就不运行）
# SOCIALDATA_API_KEY=
# 微信公众号：极致了（Dajiala）
# DAJIALA_KEY=
# 抓不到正文时用浏览器渲染兜底：Jina Reader
# JINA_API_KEY=
# 读 GitHub 接口类信源时提高配额（只读 token）
# GITHUB_TOKEN=
# 模型榜里 Artificial Analysis 这一项评测需要它自己的 key
# ARTIFICIAL_ANALYSIS_API_KEY=

# ===== 选填：飞书 =====
# 精选推送到飞书群：在后台“设置 → 推送目标”里启用，webhook 地址填在这里。
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# 告警、反馈转发到内部飞书群（需要一个飞书自建应用）：
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# 用飞书账号登录后台（可选，和管理员密码并存）：
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== 选填：其他 =====
# 外部脚本往站里推送内容（POST /api/ingest/items）用的 token，至少 16 位；不填就关闭这个接口。
# INGEST_TOKEN=
# 抓取海外信源要走代理时（比如服务器在中国大陆）：
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# 前面有 Caddy 或 Nginx 这类反向代理时设为 true，访客地址才从代理的 X-Forwarded-For 里读；
# 网站直接对外时保持 false，免得有人伪造地址绕过登录次数和反馈的限制。
TRUST_PROXY=false
# MCP 只接受发给 SITE_URL 域名（和 localhost）的请求；还有别的访问域名时，逗号分隔写在这里：
# MCP_ALLOWED_HOSTS=
# 网站多久没有新内容就算“停止收录”并告警（分钟，默认 360）：
# ALERT_QUIET_MINUTES=360
# 每天把新页面提交给 IndexNow（Bing 等）；key 是 32 位十六进制，自己生成一个：
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# 数据库每天备份到 S3 兼容的对象存储（腾讯云 COS、AWS S3、阿里云 OSS……）：
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=

# ===== 安全阀 =====
# 关掉就不抓信源、不调模型（调试界面时有用）。
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== 不用 Docker、直接在本机跑时才需要 =====
# DATABASE_URL=postgres://用户名@127.0.0.1:5432/finhot
# API_BASE_URL=http://127.0.0.1:3001
# 开发时免登录进后台（生产环境会拒绝启动）：
# DEV_AUTH_ROLE=admin

# ===== 用 docker compose --profile https 时 =====
# SITE_DOMAIN=example.com

# ===== FinHot 扩展 =====
# DeepSeek 直连（可选，与 LLM_API_KEY 二选一或并用）：
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 公开站点除金融外还展示哪些领域、日报包含哪些领域（逗号分隔，如 ai）：
# FINHOT_PUBLIC_DOMAINS=
# FINHOT_REPORT_DOMAINS=
# 只对这个时间（ISO）之后发现的文章调用付费模型，之前的只建索引：
# FINHOT_PROCESS_SINCE=
# 为公开英文版生成英文标题和摘要：
# FINHOT_PUBLIC_EN_ENABLED=false

# ===== 混合部署：服务器 → Cloudflare 同步 =====
# 详见 docs/cloudflare.md。同步入口写同步 Worker 的根地址（只要 https://域名/，路径 /_sync/ 由程序自己加），
# 令牌至少 32 位，与 Worker 的 SYNC_TOKEN 一致：
# FINHOT_SYNC_URL=https://sync.example.com/
# FINHOT_SYNC_TOKEN=
# FINHOT_SYNC_STATE=/var/lib/finhot/public-sync-state.json
# Cloudflare 前台回源服务器时使用的令牌（服务器端 FINHOT_ORIGIN_TOKEN 与 Worker 的 BACKEND_TOKEN 相同）：
# FINHOT_ORIGIN_TOKEN=

# ===== 调优：一般不用改 =====
# 摘要优先：每条资料先写一份普通摘要（7 天内的、按信源轮流、新的先），评分复核排在后面；
# 模型的每日金额上限按比例分给两边（BUDGET_SHARE 是普通摘要的份额，0.1—0.9，默认 0.7）：
# FINHOT_BRIEF_FIRST=false
# FINHOT_BRIEF_BUDGET_SHARE=0.7
# 日报导语、事件综述，设为 false 就不写（省模型调用）：
# FINHOT_REPORT_LEAD_ENABLED=true
# FINHOT_STORY_DIGEST_ENABLED=true
# 抓不到正文时是否用 Jina Reader 兜底（填了 JINA_API_KEY 才会用）：
# JINA_BODY_FALLBACK=true
# 只抓这几类信源（逗号分隔）；开发时可以设 COLLECT_SKIP_JINA=true，跳过要经 Jina 读取的列表页：
# COLLECT_KINDS=rss,web_list,json_list,x_search
# COLLECT_SKIP_JINA=false
# 向量：有 key 也可以关掉；维度（0 表示交给模型，DashScope 默认 1024）：
# EMBEDDINGS_ENABLED=true
# EMBEDDING_DIMS=
# 思考模式关不掉的模型会把思考算进 max_tokens，这里给每一步再加一些额度：
# LLM_REASONING_HEADROOM=0
# 并发：每分钟最多排多少个信源、同时抓几个、同时处理几条资料、同时提取几篇正文（小内存机器调低）：
# FETCH_SCHEDULE_BATCH=40
# FETCH_CONCURRENCY=8
# ANALYZE_CONCURRENCY=6
# EXTRACT_CONCURRENCY=4
# 数据库连接池上限（每个进程）：
# DATABASE_POOL_MAX=10
# 搜索同时执行几条、最多排队几条，再多直接返回 503：
# SEARCH_MAX_CONCURRENCY=4
# SEARCH_MAX_QUEUE=8
# 精选入选后多少秒才公开（留时间给后续步骤补全）：
# SELECTED_VISIBLE_AFTER_SECONDS=180
# 监听地址和端口（Docker 里已经设好；本机直接跑时默认只听 127.0.0.1）：
# API_HOST=127.0.0.1
# API_PORT=3001
# WEB_HOST=127.0.0.1
# WEB_PORT=3000
# worker 预热分享图时访问网页的地址：
# LOCAL_ROUTER_URL=http://127.0.0.1:3000
# 日志级别（fatal/error/warn/info/debug）：
# LOG_LEVEL=info
# 告警里显示的环境名（production 不加前缀）、上传与缓存的目录、版本号（只用于后台显示）：
# AIHOT_ENVIRONMENT=production
# AIHOT_DATA_DIR=./.data
# AIHOT_RELEASE=dev
# 按组拆开的密钥文件目录（models.env、collectors.env、integrations.env、auth.env），环境变量优先：
# AIHOT_CREDENTIALS_DIR=
# 付费服务的接口地址（一般不用改）：
# SOCIALDATA_BASE_URL=
# DAJIALA_BASE_URL=
# JINA_BASE_URL=
# 开发时允许抓取内网地址（生产环境会拒绝启动）；图片代理是否要求签名（保持 true）：
# ALLOW_PRIVATE_NETWORK_FETCH=false
# IMG_PROXY_REQUIRE_SIG=true
