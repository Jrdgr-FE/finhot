[Unit]
Description=FinHot collection and editorial worker
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=finhot
Group=finhot
WorkingDirectory=/opt/finhot/current
EnvironmentFile=/etc/finhot/worker.env
ExecStart=/opt/finhot/runtime/bin/node --max-old-space-size=320 apps/worker/src/main.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=240
MemoryHigh=384M
MemoryMax=512M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/finhot
UMask=0077

[Install]
WantedBy=multi-user.target
