[Unit]
Description=FinHot website
After=network-online.target finhot-api.service
Wants=network-online.target finhot-api.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=finhot
Group=finhot
WorkingDirectory=/opt/finhot/current
EnvironmentFile=/etc/finhot/web.env
ExecStart=/opt/finhot/runtime/bin/node --max-old-space-size=192 apps/web/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
MemoryHigh=256M
MemoryMax=320M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/finhot
UMask=0077

[Install]
WantedBy=multi-user.target
