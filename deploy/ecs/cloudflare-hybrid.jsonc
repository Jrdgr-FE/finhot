{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"finhot-free",
  "account_id":"<CLOUDFLARE_ACCOUNT_ID>",
  "main":"../free/worker.ts",
  "compatibility_date":"2026-10-01",
  "workers_dev":true,
  "preview_urls":false,
  "routes": [],
  "assets":{"directory":"../../.data/build/hybrid/public","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*","/feed.xml","/robots.txt","/llms.txt"]},
  "vars":{"SITE_URL":"https://finhot.fun","BACKEND_ORIGIN":"https://api.finhot.fun","PREVIEW_ONLY":"false","COLLECT_ENABLED":"false","MODEL_CALLS_ENABLED":"false","AI_DAILY_LIMIT":"0"},
  "observability":{"enabled":true,"head_sampling_rate":0.1}
}
