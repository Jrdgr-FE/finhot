{
  "$schema":"../../node_modules/wrangler/config-schema.json",
  "name":"finhot-free",
  "account_id":"<CLOUDFLARE_ACCOUNT_ID>",
  "main":"cloudflare-sync-worker.ts",
  "compatibility_date":"2026-10-01",
  "workers_dev":true,"preview_urls":false,"routes":[{"pattern":"finhot.fun","custom_domain":true,"zone_id":"<CLOUDFLARE_ZONE_ID>"}],
  "assets":{"directory":"../../.data/build/hybrid/public","binding":"ASSETS","not_found_handling":"single-page-application","html_handling":"drop-trailing-slash","run_worker_first":["/api/*","/_sync/*","/articles/*","/daily/*","/feed.xml","/feed/*","/sitemap.xml","/robots.txt","/llms.txt"]},
  "d1_databases":[{"binding":"DB","database_name":"finhot-public-sync","database_id":"<D1_DATABASE_ID>","migrations_dir":"migrations"}],
  "triggers":{"crons":["*/10 * * * *"]},
  "ratelimits":[{"name":"AUTH_RATE_LIMITER","namespace_id":"1001","simple":{"limit":20,"period":60}},{"name":"PUBLIC_RATE_LIMITER","namespace_id":"1002","simple":{"limit":240,"period":60}}],
  "vars":{"SITE_URL":"https://finhot.fun","PREVIEW_ONLY":"false","PUBLIC_ONLY":"true"},
  "observability":{"enabled":true,"head_sampling_rate":0.1}
}
