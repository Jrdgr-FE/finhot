[Unit]
Description=FinHot local PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=finhot
Group=finhot
EnvironmentFile=/etc/finhot/backup.env
ExecStart=/bin/bash /opt/finhot/current/deploy/ecs/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/finhot
UMask=0077
